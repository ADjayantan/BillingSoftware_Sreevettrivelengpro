# Copy to .env.local and fill in. Never commit .env.local.

# --- Public (shipped to the browser). ONLY these three may be NEXT_PUBLIC_*. ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Publishable key (sb_publishable_...), or the legacy anon key. Never the secret key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# --- Server only. Set in Vercel as sensitive variables. ---
# Secret key (sb_secret_...) / legacy service_role: cron and admin code only, bypasses RLS.
SUPABASE_SECRET_KEY=
CRON_SECRET=

# Sprint 3: Drive archive (dedicated company account) and Web Push
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=
GOOGLE_DRIVE_ROOT_FOLDER_ID=
VAPID_PRIVATE_KEY=

# Sprint 4: AI and alerts
GEMINI_API_KEY_PRIMARY=
GEMINI_API_KEY_FALLBACK=
TELEGRAM_BOT_TOKEN=
