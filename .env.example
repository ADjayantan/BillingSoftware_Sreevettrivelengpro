# Copy to .env.local and fill in. Never commit .env.local.

# --- Public (shipped to the browser). ONLY these three may be NEXT_PUBLIC_*. ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Publishable key (sb_publishable_...), or the legacy anon key. Never the secret key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# --- Server only. Set in Vercel as sensitive variables. ---
# Secret key (sb_secret_...) / legacy service_role: cron and admin code only, bypasses RLS.
SUPABASE_SECRET_KEY=
# At least 32 characters: the Company page's Drive link is sealed with a key made from it
# (specs/drive-button.md). Changing it means pressing "Connect again" on the Company page.
CRON_SECRET=

# Task B: Isolated Google Drive Vault (Company_Billing_Vault) and Web Push
GOOGLE_DRIVE_ROOT_FOLDER_ID=
# A personal Google account (plain Gmail): filled in by `node scripts/drive-connect.ts`.
# The Company page's "Connect Google Drive" uses the same client: a "Web application" client
# that allows https://<site>/api/drive/callback. Its link, once made, wins over these settings.
GOOGLE_DRIVE_OAUTH_CLIENT_ID=
GOOGLE_DRIVE_OAUTH_CLIENT_SECRET=
GOOGLE_DRIVE_OAUTH_REFRESH_TOKEN=
# Or a service account, which needs a Google Workspace Shared Drive.
GOOGLE_DRIVE_CLIENT_EMAIL=
GOOGLE_DRIVE_PRIVATE_KEY=
# Optional alternatives from specs/golive-runbook.md (JSON bundle & Shared Drive ID)
GOOGLE_DRIVE_SERVICE_ACCOUNT_JSON=
GOOGLE_DRIVE_SHARED_DRIVE_ID=
VAPID_PRIVATE_KEY=

# Task A: AI and Telegram alerts (server-only)
GEMINI_API_KEY=
GEMINI_API_KEY_PRIMARY=
GEMINI_API_KEY_FALLBACK=
# Only to use another model than the one in src/lib/gemini.ts, e.g. when Google retires that one.
GEMINI_MODEL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_OWNER_CHAT_ID=
