{
  "name": "studflow",
  "productName": "StudFlow",
  "version": "1.0.0",
  "description": "StudFlow billing and dispatch, in its own window on the PC",
  "author": "StudFlow",
  "license": "UNLICENSED",
  "private": true,
  "main": "dist/main.js",
  "type": "commonjs",
  "scripts": {
    "build": "tsc -p .",
    "start": "tsc -p . && electron .",
    "icon": "electron scripts/make-icon.cjs",
    "package": "tsc -p . && electron-forge package",
    "make": "tsc -p . && electron-forge make"
  },
  "dependencies": {
    "electron-squirrel-startup": "1.0.1"
  },
  "devDependencies": {
    "@electron-forge/cli": "8.0.1",
    "@electron-forge/maker-squirrel": "8.0.1",
    "@electron-forge/plugin-fuses": "8.0.1",
    "@electron/fuses": "2.1.3",
    "@types/node": "26.6.6",
    "electron": "45.5.0",
    "typescript": "6.0.3"
  },
  "allowScripts": {
    "electron-winstaller@5.4.4": true
  }
}
